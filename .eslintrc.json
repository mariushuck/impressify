{
  "extends": ["next/core-web-vitals"],
  "plugins": ["@stylistic"],
  "rules": {
    "@stylistic/semi": ["error", "always"],
    "@stylistic/quotes": ["error", "single"],
    "@stylistic/indent": ["error", 2],
    "@stylistic/comma-dangle": ["error", "always-multiline"],
    "@stylistic/no-trailing-spaces": "error"
  }
}
